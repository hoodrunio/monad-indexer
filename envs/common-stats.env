# Stats Service Configuration
# ============================

# Server Settings
STATS__SERVER__HTTP__ENABLED=true
STATS__SERVER__HTTP__ADDR=0.0.0.0:8080
STATS__SERVER__GRPC__ENABLED=false

# Database URLs (will be set by docker-compose)
# STATS__DB_URL=postgresql://postgres:PASSWORD@stats-db:5432/stats
# STATS__BLOCKSCOUT_DB_URL=postgresql://postgres:PASSWORD@db:5432/blockscout

# Database Settings
STATS__CREATE_DATABASE=true
STATS__RUN_MIGRATIONS=true

# Metrics
STATS__METRICS__ENABLED=true
STATS__METRICS__ADDR=0.0.0.0:6060
STATS__METRICS__ROUTE=/metrics

# Tracing
STATS__TRACING__ENABLED=false
STATS__JAEGER__ENABLED=false

# Update Schedules (cron format)
# Update every 30 minutes
STATS__CHARTS_CONFIG__COUNTERS__UPDATE_SCHEDULE="0 */30 * * * * *"
STATS__CHARTS_CONFIG__LINES__UPDATE_SCHEDULE="0 */30 * * * * *"

# Concurrency
STATS__CONCURRENT_START_UPDATES=5

# Cache
STATS__FORCE_UPDATE_ON_START=false
STATS__IGNORE_BLOCKSCOUT_API_ABSENCE=true
