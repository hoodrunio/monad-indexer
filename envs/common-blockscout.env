# ============================================
# MONAD TESTNET INDEXER - BACKEND CONFIG
# ============================================

# Database Connection
DATABASE_URL=postgresql://blockscout:ceWb1MeLBEeOIfk65gU8EjF8@db:5432/blockscout
ECTO_USE_SSL=false
POOL_SIZE=80
POOL_SIZE_API=10

# RPC Configuration (Override via docker-compose)
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_TRANSPORT=http
ETHEREUM_JSONRPC_HTTP_URL=http://host.docker.internal:8545/
ETHEREUM_JSONRPC_TRACE_URL=http://host.docker.internal:8545/
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=false

# Chain Configuration
# CHAIN_ID is set in docker-compose.backend.yml

# Security
SECRET_KEY_BASE=56NtB48ear7+wMSf0IQuWDAAazhpb31qyc7GiyspBP2vh7t5zlCsF5QDv76chXeN

# API Server
PORT=4000
DISABLE_WEBAPP=true
ADMIN_PANEL_ENABLED=false
API_V1_READ_METHODS_DISABLED=false
API_V1_WRITE_METHODS_DISABLED=false

# Market Data (Disabled for indexing-only setup)
COIN_NAME=
COIN=
DISABLE_MARKET=true

# Microservices (URLs are defaults, enable/disable via docker-compose)
MICROSERVICE_SC_VERIFIER_TYPE=sc_verifier
MICROSERVICE_VISUALIZE_SOL2UML_URL=http://visualizer:8050/
MICROSERVICE_SIG_PROVIDER_URL=http://sig-provider:8050/

# Rate Limiting
# API_RATE_LIMIT_DISABLED=false
# API_RATE_LIMIT_BY_IP_TIME_INTERVAL=5m
# API_RATE_LIMIT_BY_IP=3000

# Redis Cache
API_RATE_LIMIT_HAMMER_REDIS_URL=redis://redis-db:6379/1
ACCOUNT_REDIS_URL=redis://redis-db:6379

# Accounts (Disabled - no user authentication needed)
ACCOUNT_ENABLED=false
ACCOUNT_CLOAK_KEY=

# Indexer Configuration
# DISABLE_INDEXER=false
# DISABLE_REALTIME_INDEXER=false
# DISABLE_CATCHUP_INDEXER=false

# Indexer Performance Tuning
# INDEXER_CATCHUP_BLOCKS_BATCH_SIZE=10
# INDEXER_CATCHUP_BLOCKS_CONCURRENCY=10
# INDEXER_RECEIPTS_BATCH_SIZE=250
# INDEXER_RECEIPTS_CONCURRENCY=10
# INDEXER_COIN_BALANCES_BATCH_SIZE=100
# INDEXER_COIN_BALANCES_CONCURRENCY=10
# INDEXER_TOKEN_BALANCES_BATCH_SIZE=100
# INDEXER_TOKEN_BALANCES_CONCURRENCY=10

# Transaction History
TXS_STATS_DAYS_TO_COMPILE_AT_INIT=10
COIN_BALANCE_HISTORY_DAYS=90

# Contract Interaction
DECODE_NOT_A_CONTRACT_CALLS=true

# NFT Media Handling (Remote dispatcher mode)
NFT_MEDIA_HANDLER_ENABLED=true
NFT_MEDIA_HANDLER_REMOTE_DISPATCHER_NODE_MODE_ENABLED=true
NFT_MEDIA_HANDLER_BUCKET_FOLDER=/folder_1
RELEASE_NODE=producer@172.18.0.4
RELEASE_DISTRIBUTION=name
RELEASE_COOKIE=secret_cookie

# Logging
DISABLE_FILE_LOGGING=false
HEART_BEAT_TIMEOUT=30
RELEASE_LINK=

# reCAPTCHA (Disabled for API-only usage)
RE_CAPTCHA_DISABLED=false

# ============================================
# ADVANCED SETTINGS (Uncomment to customize)
# ============================================

# Block Range Limits
# FIRST_BLOCK=0
# LAST_BLOCK=

# Database Event Notifications
# INDEXER_DB_EVENT_NOTIFICATIONS_CLEANUP_ENABLED=true

# Token Balance Fetching
# TOKEN_BALANCE_ON_DEMAND_FETCHER_THRESHOLD=
# COIN_BALANCE_ON_DEMAND_FETCHER_THRESHOLD=

# Contract Verification
# CONTRACT_VERIFICATION_ALLOWED_SOLIDITY_EVM_VERSIONS=homestead,tangerineWhistle,spuriousDragon,byzantium,constantinople,petersburg,istanbul,berlin,london,paris,shanghai,cancun,prague,default
# CONTRACT_VERIFICATION_ALLOWED_VYPER_EVM_VERSIONS=byzantium,constantinople,petersburg,istanbul,berlin,paris,shanghai,cancun,default
# CONTRACT_VERIFICATION_MAX_LIBRARIES=10

# Sourcify Integration
