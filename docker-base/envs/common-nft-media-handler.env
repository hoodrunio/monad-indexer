# ============================================
# NFT MEDIA HANDLER CONFIGURATION
# ============================================
# Note: Currently not used in modular setup
# NFT handling is integrated into the backend service

# This file is kept for reference if you want to enable
# standalone NFT media handling in the future

# AWS S3 Configuration
# NFT_MEDIA_HANDLER_AWS_ACCESS_KEY_ID=
# NFT_MEDIA_HANDLER_AWS_SECRET_ACCESS_KEY=
# NFT_MEDIA_HANDLER_AWS_REGION=
# NFT_MEDIA_HANDLER_AWS_BUCKET=
# NFT_MEDIA_HANDLER_AWS_PUBLIC_BUCKET_URL=

# Backfill Settings
# NFT_MEDIA_HANDLER_BACKFILL_ENABLED=false
# NFT_MEDIA_HANDLER_BACKFILL_QUEUE_SIZE=1000
# NFT_MEDIA_HANDLER_BACKFILL_ENQUEUE_BUSY_WAITING_TIMEOUT=10000

# Cache Settings
# NFT_MEDIA_HANDLER_CACHE_UNIQUENESS_MAX_SIZE=10000
