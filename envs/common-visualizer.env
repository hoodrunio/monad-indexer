# Visualizer Service Configuration
# ==================================

# Server Settings
VISUALIZER__SERVER__HTTP__ENABLED=true
VISUALIZER__SERVER__HTTP__ADDR=0.0.0.0:8050
VISUALIZER__SERVER__GRPC__ENABLED=false

# Metrics
VISUALIZER__METRICS__ENABLED=true
VISUALIZER__METRICS__ADDR=0.0.0.0:6060
VISUALIZER__METRICS__ROUTE=/metrics

# Tracing
VISUALIZER__TRACING__ENABLED=false
VISUALIZER__JAEGER__ENABLED=false

# Solidity Visualizer
VISUALIZER__SOLIDITY__ENABLED=true
VISUALIZER__SOLIDITY__REFRESH_RATE=1h

# Vyper Visualizer
VISUALIZER__VYPER__ENABLED=true
VISUALIZER__VYPER__REFRESH_RATE=1h
