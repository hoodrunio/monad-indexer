# Frontend Configuration for Monad Testnet
# ==========================================

# API Configuration
NEXT_PUBLIC_API_HOST=localhost
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_PORT=80
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=ws

# Stats API
NEXT_PUBLIC_STATS_API_HOST=http://localhost:8080

# Network Information
NEXT_PUBLIC_NETWORK_NAME=Monad Testnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=Monad
NEXT_PUBLIC_NETWORK_ID=10143
NEXT_PUBLIC_NETWORK_RPC_URL=https://testnet-rpc.monad.xyz

# Currency
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=MON
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=MON
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18

# App Configuration
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_APP_PORT=80

# Features
NEXT_PUBLIC_IS_TESTNET=true
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs','coin_price','market_cap']

# Visualizer
NEXT_PUBLIC_VISUALIZE_API_HOST=http://localhost:8081

# API Spec
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml

# Wallet Connect (optional - uncomment if needed)
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Footer Links (optional)
# NEXT_PUBLIC_FOOTER_GITHUB_LINK=https://github.com/monad-xyz
# NEXT_PUBLIC_FOOTER_TWITTER_LINK=https://twitter.com/monad_xyz

# Marketplace (optional)
NEXT_PUBLIC_MARKETPLACE_ENABLED=false

# Account Features (optional)
# NEXT_PUBLIC_AUTH_URL=
# NEXT_PUBLIC_LOGOUT_URL=

# Rollup Features (if applicable)
NEXT_PUBLIC_ROLLUP_TYPE=
NEXT_PUBLIC_ROLLUP_L1_BASE_URL=
NEXT_PUBLIC_ROLLUP_L2_WITHDRAWAL_URL=

# Other Features
NEXT_PUBLIC_HAS_USER_OPS=false
NEXT_PUBLIC_TRANSACTION_INTERPRETATION_PROVIDER=none
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_ADMIN_SERVICE_API_HOST=

# OG Tags
NEXT_PUBLIC_OG_DESCRIPTION=Monad Testnet Explorer - High-performance EVM-compatible blockchain
NEXT_PUBLIC_OG_IMAGE_URL=
