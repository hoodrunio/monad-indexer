# Monad Indexer Configuration

# RPC Endpoints
ETHEREUM_JSONRPC_HTTP_URL=https://testnet-rpc.monad.xyz
ETHEREUM_JSONRPC_TRACE_URL=https://testnet-rpc.monad.xyz
ETHEREUM_JSONRPC_WS_URL=wss://testnet-rpc.monad.xyz

# Enable Microservices (when using docker-compose.microservices.yml)
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=true
MICROSERVICE_SIG_PROVIDER_ENABLED=true

# External Database (when using docker-compose.external-db.yml)
# DATABASE_URL=postgresql://user:pass@host:5432/blockscout
# REDIS_URL=redis://host:6379
