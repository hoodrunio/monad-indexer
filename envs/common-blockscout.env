# Monad Testnet Configuration for Blockscout
# ==========================================

# JSON RPC Variant - Monad is geth-compatible
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_TRANSPORT=http

# IMPORTANT: Update these with your Monad RPC endpoints!
# Kendi Monad node'unuzu kullanmanız şiddetle önerilir
ETHEREUM_JSONRPC_HTTP_URL=https://testnet-rpc.monad.xyz
ETHEREUM_JSONRPC_TRACE_URL=https://testnet-rpc.monad.xyz
# ETHEREUM_JSONRPC_WS_URL=wss://testnet-rpc.monad.xyz

# Chain Configuration
COIN=MON
NETWORK=Monad
SUBNETWORK=Monad Testnet
CHAIN_ID=10143

# Logo (optional - Monad logo URL)
# LOGO=/images/monad_logo.svg
# LOGO_FOOTER=/images/monad_logo.svg

# Database Configuration
# Database URL will be set by docker-compose via environment variable
# DATABASE_URL=postgresql://postgres:PASSWORD@db:5432/blockscout

# Secret Key Base - CRITICAL: Generate with openssl rand -base64 64
# IMPORTANT: Replace this before production use!
SECRET_KEY_BASE=PLEASE_REPLACE_THIS_WITH_A_SECURE_RANDOM_STRING_GENERATED_BY_OPENSSL_RAND_BASE64_64

# Indexer Performance Tuning for High TPS
INDEXER_MEMORY_LIMIT=4
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true

# Block Fetcher Settings
INDEXER_CATCHUP_BLOCKS_BATCH_SIZE=50
INDEXER_CATCHUP_BLOCKS_CONCURRENCY=10
BLOCK_TRANSFORMER=base

# Transaction Receipt Fetcher (Important for high TPS)
INDEXER_RECEIPTS_BATCH_SIZE=500
INDEXER_RECEIPTS_CONCURRENCY=20

# Internal Transactions
INDEXER_INTERNAL_TRANSACTIONS_BATCH_SIZE=50
INDEXER_INTERNAL_TRANSACTIONS_CONCURRENCY=4
# For faster initial sync, you can disable internal transactions:
# INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true

# Coin Balance Fetcher
INDEXER_COIN_BALANCES_BATCH_SIZE=500
INDEXER_COIN_BALANCES_CONCURRENCY=10

# Token Balance Fetcher
INDEXER_TOKEN_BALANCES_BATCH_SIZE=100
INDEXER_TOKEN_BALANCES_CONCURRENCY=10

# Microservices Configuration
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_SC_VERIFIER_URL=http://smart-contract-verifier:8050/
MICROSERVICE_SC_VERIFIER_TYPE=sc_verifier

MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=true
MICROSERVICE_VISUALIZE_SOL2UML_URL=http://visualizer:8050/

MICROSERVICE_SIG_PROVIDER_ENABLED=true
MICROSERVICE_SIG_PROVIDER_URL=http://sig-provider:8050/

# API Configuration
API_V2_ENABLED=true
API_RATE_LIMIT_DISABLED=false

# Redis
REDIS_URL=redis://redis-db:6379

# Port Configuration
PORT=4000

# Disable File Logging (use docker logs instead)
DISABLE_FILE_LOGGING=true

# Exchange Rates (optional - for token prices)
# EXCHANGE_RATES_COIN=MON

# Account Settings
# ACCOUNT_ENABLED=true
# ACCOUNT_AUTH0_DOMAIN=
# ACCOUNT_AUTH0_CLIENT_ID=
# ACCOUNT_AUTH0_CLIENT_SECRET=

# Admin Panel (optional)
# ADMIN_PANEL_ENABLED=false

# Other Performance Settings
ETHEREUM_JSONRPC_HTTP_TIMEOUT=60000
ETHEREUM_JSONRPC_WAIT_PER_TIMEOUT=20000

# Pool Sizes
POOL_SIZE=50
POOL_SIZE_API=50

# Cache Settings
CACHE_BLOCK_COUNT_PERIOD=7200
CACHE_TXS_COUNT_PERIOD=7200
CACHE_ADDRESS_WITH_BALANCES_UPDATE_INTERVAL=1800

# Token Metadata
FETCH_REWARDS_WAY=manual
