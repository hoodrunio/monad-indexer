# ============================================
# BLOCKSCOUT FRONTEND CONFIGURATION
# ============================================
# Next.js frontend for Blockscout

# API Configuration - Connect to backend
NEXT_PUBLIC_API_HOST=46.62.226.167
NEXT_PUBLIC_API_PORT=4000
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=ws

# App Configuration
NEXT_PUBLIC_APP_HOST=46.62.226.167
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_APP_INSTANCE=monad-testnet
NEXT_PUBLIC_APP_ENV=production

# Network Configuration
NEXT_PUBLIC_NETWORK_NAME=Monad Testnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=Monad
NEXT_PUBLIC_NETWORK_ID=10143
NEXT_PUBLIC_IS_TESTNET=true
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Monad
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=MON
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18

# RPC Endpoint (for WalletConnect interactions)
NEXT_PUBLIC_NETWORK_RPC_URL=https://testnet-rpc.monad.xyz

# Microservices Configuration
NEXT_PUBLIC_VISUALIZE_API_HOST=http://46.62.226.167:8050
NEXT_PUBLIC_CONTRACT_INFO_API_HOST=http://46.62.226.167:8050

# Contract Verification Features
NEXT_PUBLIC_VIEWS_CONTRACT_EXTRA_VERIFICATION_METHODS=['solidity-hardhat','solidity-foundry']
NEXT_PUBLIC_VIEWS_CONTRACT_LANGUAGE_FILTERS=['solidity','vyper']

# UI Features
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs','coin_price','market_cap']
# NEXT_PUBLIC_HOMEPAGE_PLATE_TEXT_COLOR and NEXT_PUBLIC_HOMEPAGE_PLATE_BACKGROUND are deprecated
# Use NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG instead if needed

# Footer - Disable external footer links (causes validation error)
# NEXT_PUBLIC_FOOTER_LINKS requires a JSON file, not a website URL
# NEXT_PUBLIC_FOOTER_LINKS=https://monad.xyz

# Optional: WalletConnect for contract interaction
# Get free project ID from https://cloud.walletconnect.com
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional: Analytics (disabled - PostHog variable is deprecated)
# NEXT_PUBLIC_APP_POSTHOG_ENABLED is deprecated, removing it
NEXT_PUBLIC_ADMIN_SERVICE_API_HOST=

# Re-captcha (disable for now)
NEXT_PUBLIC_RE_CAPTCHA_APP_SITE_KEY=
