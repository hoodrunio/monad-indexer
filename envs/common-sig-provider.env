# ============================================
# SIGNATURE PROVIDER CONFIGURATION
# ============================================
# Resolves function signatures to human-readable names

# HTTP Server
SIG_PROVIDER__SERVER__HTTP__ENABLED=true
SIG_PROVIDER__SERVER__HTTP__ADDR=0.0.0.0:8050

# gRPC Server (disabled)
SIG_PROVIDER__SERVER__GRPC__ENABLED=false

# Metrics
SIG_PROVIDER__METRICS__ENABLED=true
SIG_PROVIDER__METRICS__ADDR=0.0.0.0:6060
SIG_PROVIDER__METRICS__ROUTE=/metrics

# Tracing (disabled)
SIG_PROVIDER__TRACING__ENABLED=false
SIG_PROVIDER__JAEGER__ENABLED=false

# ============================================
# SIGNATURE SOURCES
# ============================================
# Officially supported decoding sources by Blockscout sig-provider:
# - 4byte directory (fourbyte)
# - Openchain signatures (sigeth - sig.eth.samczsun.com)
# - Ethereum bytecode database

# Source 1: 4byte Directory (Primary)
SIG_PROVIDER__SOURCES__FOURBYTE=https://www.4byte.directory/

# Source 2: OpenChain Signature Database (sig.eth.samczsun.com)
# Note: May have DNS issues on some servers
SIG_PROVIDER__SOURCES__SIGETH=https://sig.eth.samczsun.com/

# Source 3: Ethereum Bytecode Database (Contract verification)
SIG_PROVIDER__SOURCES__ETH_BYTECODE_DB__ENABLED=true
SIG_PROVIDER__SOURCES__ETH_BYTECODE_DB__URL=https://eth-bytecode-db.services.blockscout.com/
